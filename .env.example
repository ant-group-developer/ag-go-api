# Runtime
NODE_ENV=development
PORT=3000
API_PREFIX=api
FRONTEND_ORIGIN=http://localhost:5173

# Container resource limits
API_MEMORY_LIMIT=2g
API_CPUS=2
WORKER_MEDIA_MEMORY_LIMIT=2g
WORKER_MEDIA_CPUS=2
WORKER_IO_MEMORY_LIMIT=1g
WORKER_IO_CPUS=1
# Rotated container logs (docker-compose.yml)
LOG_MAX_SIZE=50m
LOG_MAX_FILE=5

# PostgreSQL / Redis
DATABASE_URL=postgres://aggo:aggo@localhost:55432/aggo
DATABASE_SCHEMA=public
# Connections per process (api: DATABASE_POOL_MAX, each worker: WORKER_DATABASE_POOL_MAX).
# All processes on all hosts together must stay under Postgres max_connections.
DATABASE_POOL_MAX=10
WORKER_DATABASE_POOL_MAX=5
REDIS_URL=redis://:replace-with-redis-password@localhost:6379

# Upload and media worker
UPLOAD_SESSION_TTL_SECONDS=3600
MAX_UPLOAD_SIZE_BYTES=104857600
MEDIA_WORKER_ENABLED=true
QUEUE_PREFIX=ag-go
MEDIA_WORKER_CONCURRENCY=2
MEDIA_FFMPEG_THREADS=2
OUTBOX_POLL_INTERVAL_MS=1000
MEDIA_JOB_ATTEMPTS=3
MEDIA_JOB_BACKOFF_MS=5000
MEDIA_RENDER_TIMEOUT_SECONDS=300
MEDIA_THUMBNAIL_MAX_WIDTH=720
MEDIA_PREVIEW_MAX_WIDTH=1920

# Cloudflare R2
# Generate an S3 API token in Cloudflare R2 and fill in all values below.
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=replace-with-r2-bucket
R2_ENDPOINT=https://replace-with-cloudflare-account-id.r2.cloudflarestorage.com
R2_PRESIGNED_URL_TTL_SECONDS=900

# Auth0
# Use the Custom API identifier configured for this environment as the audience.
AUTH0_ISSUER_URL=https://replace-with-auth0-domain/
AUTH0_AUDIENCE=https://replace-with-api-identifier/
AUTH0_CLIENT_ID=replace-with-auth0-application-client-id
AUTH0_JWKS_URL=https://replace-with-auth0-domain/.well-known/jwks.json
# Comma-separated list of allowed Auth0 client IDs (azp claim).
# When set, replaces AUTH0_CLIENT_ID for azp validation — useful when multiple
# SPA apps (ag-go-web, ag-studio-web, ag-farm-web) share this API.
# AUTH0_ALLOWED_CLIENT_IDS=client-id-1,client-id-2

# Service-key authentication (used by ag-studio to act as users via X-Service-Key + X-Act-As-User)
# JSON array: [{"name":"studio","sha256":"<hex of sha256(raw-key)>","scopes":["footage:read","footage:resolve"]}]
SERVICE_KEYS=

# Account API (optional until account integration is enabled)
ACCOUNT_API_URL=http://localhost:8081/v2
ACCOUNT_API_KEY=replace-with-account-api-key
# Path template for user access lookup (user_type + permissions by userId).
# {userId} is replaced with the encoded userId. Default used when unset.
# ACCOUNT_API_USER_ACCESS_PATH=/v2/public/users/{userId}/access?application=ant-go-v2
# Application code of ag-go in Account API; /users/me is asked for this app (default ant-go-v2)
# ACCOUNT_APPLICATION_CODE=ant-go-v2

# Google Drive OAuth (optional until Drive import is enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google-drive/connection/callback
GOOGLE_SCOPES=openid profile email https://www.googleapis.com/auth/drive.readonly
# Base64-encoded 32-byte AES-256 key
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Legacy watermark migration (optional, read once by migration 1860000000000)
# The logo object must be copied into an image asset first and its asset id supplied.
LEGACY_WATERMARK_JSON=
LEGACY_WATERMARK_LOGO_ASSET_ID=

# ag-farm integration (optional until analysis is enabled)
# FARM_URL=http://localhost:4000
FARM_OWNER_KEY=replace-with-farm-owner-key
# Ed25519 public key in PEM format; literal \n is accepted
FARM_TICKET_PUBLIC_KEY=
FARM_URL_TTL_SECONDS=3600
FARM_POLL_INTERVAL_MS=5000

# Content analysis
ANALYSIS_AUTO_ENQUEUE=false
ANALYSIS_EXTRACT_VERSION=x1
ANALYSIS_PROMPT_VERSION=p1
ANALYSIS_MODEL=qwen2.5vl:7b
